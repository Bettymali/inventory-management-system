@page "/suppliers"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="inventory-container">
    <div class="inventory-header">
        <div>
            <h3 class="inventory-title">Supplier Management</h3>
            <p style="color:#718096; margin:0; font-size:0.9rem;">Manage your product suppliers</p>
        </div>
        @if (isAdmin)
        {
            <button class="btn-primary" @onclick="ShowForm">+ Add Supplier</button>
        }
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="auth-success">@successMessage</div>
    }

    @if (showForm)
    {
        <div class="form-card">
            <h5 class="form-title">@(editingSupplier == null ? "Add New Supplier" : "Edit Supplier")</h5>
            @if (!string.IsNullOrEmpty(validationMessage))
            {
                <p class="validation-error">@validationMessage</p>
            }
            <div class="form-grid">
                <div class="form-group">
                    <label>Company Name</label>
                    <input placeholder="e.g. ABC Supplies" @bind="formSupplier.Name" class="form-input" />
                </div>
                <div class="form-group">
                    <label>Contact Person</label>
                    <input placeholder="e.g. John Smith" @bind="formSupplier.ContactPerson" class="form-input" />
                </div>
                <div class="form-group">
                    <label>Email</label>
                    <input type="email" placeholder="e.g. john@abc.com" @bind="formSupplier.Email" class="form-input" />
                </div>
                <div class="form-group">
                    <label>Phone</label>
                    <input placeholder="e.g. 555-0100" @bind="formSupplier.Phone" class="form-input" />
                </div>
                <div class="form-group">
                    <label>Address</label>
                    <input placeholder="e.g. 123 Main St" @bind="formSupplier.Address" class="form-input" />
                </div>
            </div>
            <div class="form-actions">
                <button class="btn-primary" @onclick="SaveSupplier">Save Supplier</button>
                <button class="btn-secondary" @onclick="CancelForm">Cancel</button>
            </div>
        </div>
    }

    <div class="table-card">
        <table class="inventory-table">
            <thead>
                <tr>
                    <th>Company</th>
                    <th>Contact Person</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Products</th>
                    @if (isAdmin)
                    {
                        <th>Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var supplier in suppliers)
                {
                    <tr>
                        <td class="td-name">@supplier.Name</td>
                        <td>@supplier.ContactPerson</td>
                        <td style="color:#4f46e5">@supplier.Email</td>
                        <td>@supplier.Phone</td>
                        <td><span class="category-badge">@supplier.Items.Count items</span></td>
                        @if (isAdmin)
                        {
                            <td class="td-actions">
                                <button class="btn-edit" @onclick="() => StartEdit(supplier)">Edit</button>
                                <button class="btn-delete" @onclick="() => DeleteSupplier(supplier.Id)">Delete</button>
                            </td>
                        }
                    </tr>
                }
                @if (!suppliers.Any())
                {
                    <tr>
                        <td colspan="6" class="empty-state">No suppliers yet. Add your first supplier!</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    bool isAdmin = false;
    List<Supplier> suppliers = new();
    Supplier formSupplier = new();
    Supplier? editingSupplier = null;
    bool showForm = false;
    string validationMessage = "";
    string successMessage = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        isAdmin = authState.User.IsInRole("Admin");
        await LoadSuppliers();
    }

    async Task LoadSuppliers()
    {
        using var db = DbFactory.CreateDbContext();
        suppliers = await db.Suppliers.Include(s => s.Items).ToListAsync();
    }

    void ShowForm()
    {
        editingSupplier = null;
        formSupplier = new();
        validationMessage = "";
        showForm = true;
    }

    void StartEdit(Supplier supplier)
    {
        editingSupplier = supplier;
        formSupplier = new Supplier
        {
            Id = supplier.Id,
            Name = supplier.Name,
            ContactPerson = supplier.ContactPerson,
            Email = supplier.Email,
            Phone = supplier.Phone,
            Address = supplier.Address
        };
        validationMessage = "";
        showForm = true;
    }

    void CancelForm()
    {
        showForm = false;
        editingSupplier = null;
        formSupplier = new();
        validationMessage = "";
    }

    async Task SaveSupplier()
    {
        if (string.IsNullOrWhiteSpace(formSupplier.Name))
        {
            validationMessage = "Company name is required.";
            return;
        }
        if (string.IsNullOrWhiteSpace(formSupplier.Email))
        {
            validationMessage = "Email is required.";
            return;
        }

        using var db = DbFactory.CreateDbContext();
        if (editingSupplier == null)
            db.Suppliers.Add(formSupplier);
        else
            db.Suppliers.Update(formSupplier);

        await db.SaveChangesAsync();
        successMessage = "Supplier saved successfully!";
        CancelForm();
        await LoadSuppliers();
    }

    async Task DeleteSupplier(int id)
    {
        using var db = DbFactory.CreateDbContext();
        var supplier = await db.Suppliers.FindAsync(id);
        if (supplier != null)
        {
            db.Suppliers.Remove(supplier);
            await db.SaveChangesAsync();
        }
        successMessage = "Supplier deleted.";
        await LoadSuppliers();
    }
}